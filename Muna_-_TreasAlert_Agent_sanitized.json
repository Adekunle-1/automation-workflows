    {
      "parameters": {
        "jsCode": "const csv = $input.item.json.data;\nconst lines = csv.split('\\n').filter(l => l.trim());\nconst headers = lines[0].split(',').map(h => h.replace(/\"/g, '').trim());\n \n// Parse all rows\nconst rows = [];\nfor (let i = 1; i < lines.length; i++) {\n  const values = [];\n  let current = '';\n  let inQuotes = false;\n  for (const char of lines[i]) {\n    if (char === '\"') { inQuotes = !inQuotes; }\n    else if (char === ',' && !inQuotes) { values.push(current.trim()); current = ''; }\n    else { current += char; }\n  }\n  values.push(current.trim());\n  if (values.length >= headers.length) {\n    const row = {};\n    headers.forEach((h, idx) => row[h] = values[idx] || '');\n    rows.push(row);\n  }\n}\n \n// DateTime parser: handles \"DD/MM/YYYY HH:MM AM/PM\" or plain \"DD/MM/YYYY\"\nfunction parseDateTime(str) {\n  if (!str) return new Date(0);\n  const parts = str.trim().split(' ');\n  const [d, m, y] = parts[0].split('/').map(Number);\n  let hours = 0, minutes = 0;\n  if (parts[1]) {\n    const [h, min] = parts[1].split(':').map(Number);\n    hours = h;\n    minutes = min;\n    const meridiem = (parts[2] || '').toUpperCase();\n    if (meridiem === 'PM' && hours !== 12) hours += 12;\n    if (meridiem === 'AM' && hours === 12) hours = 0;\n  }\n  return new Date(y, m - 1, d, hours, minutes);\n}\n \nfunction getDayKey(dateStr) {\n  return dateStr.trim().split(' ')[0]; // \"DD/MM/YYYY\"\n}\n \n// Normalize rows\nconst allTx = rows.map(r => ({\n  date:    r.date || '',\n  type:    (r.alert_type || '').toLowerCase().trim(),\n  amount:  parseFloat(r.amount) || 0,\n  balance: parseFloat(r.balance) || 0,\n  description: r.description || '',\n  reference:   r.reference || ''\n})).sort((a, b) => parseDateTime(a.date) - parseDateTime(b.date));\n \n// \u2500\u2500 Seed balance: back-calculate from table_2 first transaction ever \u2500\u2500\nconst firstTx = allTx[0];\nlet seedBalance = 0;\nif (firstTx) {\n  seedBalance = firstTx.type === 'debit'\n    ? firstTx.balance + firstTx.amount\n    : firstTx.balance - firstTx.amount;\n}\n \n// Group all transactions by day\nconst dayMap = {};\nallTx.forEach(tx => {\n  const day = getDayKey(tx.date);\n  if (!dayMap[day]) dayMap[day] = [];\n  dayMap[day].push(tx);\n});\n \n// Sort unique days ascending\nconst allDays = Object.keys(dayMap).sort((a, b) => {\n  const [da, ma, ya] = a.split('/').map(Number);\n  const [db, mb, yb] = b.split('/').map(Number);\n  return new Date(ya, ma-1, da) - new Date(yb, mb-1, db);\n});\n \n// Chain: opening \u2192 closing per day\n// Closing = last transaction's bank balance (col F) sorted by datetime\nconst dayBalances = {};\nlet runningBalance = seedBalance;\nallDays.forEach(day => {\n  const dayTxs = [...dayMap[day]].sort((a, b) => parseDateTime(a.date) - parseDateTime(b.date));\n  const dayClose = dayTxs[dayTxs.length - 1].balance;\n  dayBalances[day] = { opening: runningBalance, closing: dayClose };\n  runningBalance = dayClose;\n});\n \n// \u2500\u2500 Today's figures \u2500\u2500\nconst now = new Date();\nconst todayKey = `${String(now.getDate()).padStart(2,'0')}/${String(now.getMonth()+1).padStart(2,'0')}/${now.getFullYear()}`;\nconst todayStr = todayKey;\n \nconst todayTxs = (dayMap[todayKey] || []).sort((a, b) => parseDateTime(a.date) - parseDateTime(b.date));\n \nlet totalCredit = 0, totalDebit = 0, creditCount = 0, debitCount = 0;\ntodayTxs.forEach(r => {\n  if (r.type === 'credit') { totalCredit += r.amount; creditCount++; }\n  else if (r.type === 'debit') { totalDebit += r.amount; debitCount++; }\n});\n \n// Opening = previous day's closing, or seed if today is first day\nconst daysBeforeToday = allDays.filter(d => {\n  const [dd, dm, dy] = d.split('/').map(Number);\n  return new Date(dy, dm-1, dd) < new Date(now.getFullYear(), now.getMonth(), now.getDate());\n});\nconst openingBalance = daysBeforeToday.length > 0\n  ? dayBalances[daysBeforeToday[daysBeforeToday.length - 1]].closing\n  : seedBalance;\n \n// Closing = last transaction's balance today, or opening if no transactions\nconst closingBalance = todayTxs.length > 0\n  ? todayTxs[todayTxs.length - 1].balance\n  : openingBalance;\n \nconst fmt = (n) => '\u20a6' + parseFloat(n).toLocaleString('en-NG', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n \n// Build HTML for PDF\nconst html = `\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  body { font-family: Arial, sans-serif; color: #1e293b; padding: 40px; }\n  h1 { font-size: 24px; margin-bottom: 4px; }\n  .subtitle { color: #64748b; font-size: 13px; margin-bottom: 32px; }\n  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 32px; }\n  .card { border-radius: 12px; padding: 20px 24px; background: #f8fafc; border: 1px solid #e2e8f0; }\n  .card-label { font-size: 11px; text-transform: uppercase; color: #94a3b8; letter-spacing: 0.5px; margin-bottom: 8px; }\n  .card-value { font-size: 26px; font-weight: 700; color: #1e293b; }\n  .card-meta { font-size: 12px; color: #94a3b8; margin-top: 6px; }\n  .card.debit .card-value { color: #ef4444; }\n  .card.credit .card-value { color: #10b981; }\n  .net-flow { margin-top: 24px; padding: 16px 24px; background: #f1f5f9; border-radius: 10px; font-size: 14px; color: #475569; }\n  .net-flow span { font-weight: 700; }\n  .footer { margin-top: 40px; font-size: 11px; color: #94a3b8; text-align: center; border-top: 1px solid #e2e8f0; padding-top: 16px; }\n</style>\n</head>\n<body>\n  <h1>\ud83d\udcca Daily Transaction Summary</h1>\n  <p class=\"subtitle\">Date: ${todayStr} &nbsp;|&nbsp; Generated at 6:00 PM</p>\n  <div class=\"cards\">\n    <div class=\"card\">\n      <div class=\"card-label\">Opening Balance</div>\n      <div class=\"card-value\">${fmt(openingBalance)}</div>\n    </div>\n    <div class=\"card debit\">\n      <div class=\"card-label\">Total Debit</div>\n      <div class=\"card-value\">${fmt(totalDebit)}</div>\n      <div class=\"card-meta\">${debitCount} transaction${debitCount !== 1 ? 's' : ''}</div>\n    </div>\n    <div class=\"card credit\">\n      <div class=\"card-label\">Total Credit</div>\n      <div class=\"card-value\">${fmt(totalCredit)}</div>\n      <div class=\"card-meta\">${creditCount} transaction${creditCount !== 1 ? 's' : ''}</div>\n    </div>\n    <div class=\"card\">\n      <div class=\"card-label\">Closing Balance</div>\n      <div class=\"card-value\">${fmt(closingBalance)}</div>\n    </div>\n  </div>\n  <div class=\"net-flow\">\n    Net Flow: <span style=\"color: ${(totalCredit - totalDebit) >= 0 ? '#10b981' : '#ef4444'}\">${fmt(totalCredit - totalDebit)}</span>\n    &nbsp;&nbsp;|&nbsp;&nbsp; Total Transactions: <span>${todayTxs.length}</span>\n  </div>\n  <div class=\"footer\">This is an automated daily report. Do not reply to this email.</div>\n</body>\n</html>`;\n \nconst pdfPayload = JSON.stringify({\n  source: html,\n  landscape: false,\n  use_print: true,\n  format: \"A4\"\n});\n \nreturn { json: { html, pdfPayload, today: todayStr, totalCredit, totalDebit, closingBalance } };"
      },

    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.body;\nconst keyRaw = raw.key;\nconst timeRaw = raw.time;\n\n// Extract sender (From)\nconst fromMatch = keyRaw.match(/From\\s*:\\s*(.+)/i);\nconst sender = fromMatch ? fromMatch[1].trim() : \"N/A\";\n\n// Extract account number\nconst accMatch = keyRaw.match(/Acc\\s*:\\s*(\\S+)/i);\nconst account = accMatch ? accMatch[1].trim() : \"N/A\";\n\n// Determine alert type and amount (Debit, Credit, DR, or CR)\nconst debitMatch = keyRaw.match(/Debit\\s*:\\s*[A-Z]*([0-9,]+(?:\\.[0-9]{1,2})?)/i);\nconst creditMatch = keyRaw.match(/Credit\\s*:\\s*[A-Z]*([0-9,]+(?:\\.[0-9]{1,2})?)/i);\nconst drMatch = keyRaw.match(/DR\\s*:\\s*[A-Z]*([0-9,]+(?:\\.[0-9]{1,2})?)/i);\nconst crMatch = keyRaw.match(/CR\\s*:\\s*[A-Z]*([0-9,]+(?:\\.[0-9]{1,2})?)/i);\n\nlet alertType = \"N/A\";\nlet amount = \"N/A\";\n\nif (debitMatch) {\n  alertType = \"Debit\";\n  amount = debitMatch[1].replace(/,/g, '');\n} else if (creditMatch) {\n  alertType = \"Credit\";\n  amount = creditMatch[1].replace(/,/g, '');\n} else if (drMatch) {\n  alertType = \"Debit\";\n  amount = drMatch[1].replace(/,/g, '');\n} else if (crMatch) {\n  alertType = \"Credit\";\n  amount = crMatch[1].replace(/,/g, '');\n}\n\n// Extract description\nconst descMatch = keyRaw.match(/Desc\\s*:\\s*(.+)/i);\nconst description = descMatch ? descMatch[1].trim() : \"N/A\";\n\n// Extract reference\nconst refMatch = keyRaw.match(/Ref\\s*:\\s*(\\S+)/i);\nconst ref = refMatch ? refMatch[1].trim() : \"N/A\";\n\n// Extract date from table_1, fallback to timeRaw\nconst dateMatch = keyRaw.match(/Date\\s*:\\s*(\\d{2}\\/\\d{2}\\/\\d{4})\\s+(\\d{1,2}:\\d{2}\\s*[APM]{2})/i);\nlet datetime = \"N/A\";\nif (dateMatch) {\n  datetime = `${dateMatch[1]} ${dateMatch[2].trim()}`;\n} else if (timeRaw) {\n  datetime = timeRaw;\n}\n\n// Extract balance\nconst balMatch = keyRaw.match(/Bal\\s*:\\s*[A-Z]*([0-9,]+(?:\\.[0-9]{1,2})?)/i);\nconst balance = balMatch ? balMatch[1].replace(/,/g, '') : \"N/A\";\n\nreturn {\n  json: {\n    sender,\n    account,\n    alertType,\n    amount,\n    description,\n    ref,\n    datetime,\n    balance\n  }\n};"
      },

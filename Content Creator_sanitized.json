    {
      "parameters": {
        "jsCode": "const telegramRan = $('SET: Telegram Input').isExecuted;\nconst chatRan = $('SET: Chat Input').isExecuted;\nconst brandAnalyzerRan = $('PARSE: Brand JSON').isExecuted;\n\nconst topic = brandAnalyzerRan\n  ? $('PARSE: Brand JSON').item.json.Topic\n  : telegramRan\n    ? $('SET: Telegram Input').item.json.Topic\n    : $('SET: Chat Input').item.json.Topic;\n\nconst brand_description = brandAnalyzerRan\n  ? $('PARSE: Brand JSON').item.json.brand_description\n  : '';\n\nconst brand_image_url = brandAnalyzerRan\n  ? $('PARSE: Brand JSON').item.json.brand_image_url || ''\n  : chatRan\n    ? $('SET: Chat Input').item.json.brand_image_url || ''\n    : '';\n\nconst has_brand_image = brand_image_url.length > 0;\n\n// NEW \u2014 content type detection\nconst content_type = $('AI: Classify Intent').item.json.choices[0].message.content.trim().toLowerCase() === 'video'\n  ? 'video'\n  : 'image';\n\nreturn [{\n  json: {\n    topic,\n    brand_description,\n    brand_image_url,\n    has_brand_image,\n    content_type\n  }\n}];"
      },

    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.output;\n\nlet brand;\ntry {\n  brand = JSON.parse(raw);\n} catch {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  if (match) brand = JSON.parse(match[0]);\n  else throw new Error('Could not parse Vision Agent response');\n}\n\nreturn [{\n  json: {\n    Topic: $('SET: Telegram Input').item.json.Topic || brand.suggested_topic || 'Nigerian lifestyle',\n    brand_description: `${brand.product_name} \u2014 ${brand.colors} \u2014 ${brand.style} \u2014 ${brand.packaging_details}`,\n    image_description: brand.image_description,\n    brand_image_url: $('UPLOAD: Brand Image to imgbb').item.json.data.url\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

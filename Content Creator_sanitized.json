      "parameters": {
        "promptType": "define",
        "text": "={{ $json }}",
        "options": {
          "systemMessage": "=You are a brand image analyst for Nigerian social media content creation.\n\nAnalyze this product/brand image carefully.\n\nReturn ONLY a valid JSON object \u2014 no markdown, no explanation:\n{\n  \"product_name\": \"exact product name or type\",\n  \"colors\": \"primary and secondary colors visible\",\n  \"style\": \"packaging style \u2014 bottle, sachet, can, bag, etc.\",\n  \"packaging_details\": \"label text, logo, notable design features\",\n  \"image_description\": \"one sentence describing what is shown, max 60 words\",\n  \"suggested_topic\": \"one specific Instagram post idea for this product targeting Nigerian consumers\"\n}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        928,
        1792
      ],
